### =====================================
### HEALTH
### =====================================

GET http://localhost:4002/health


### =====================================
### GET ALL EVENTS
### =====================================

GET http://localhost:4002/events


### =====================================
### PAGINATION
### =====================================

GET http://localhost:4002/events?page=1&limit=10


### =====================================
### SEARCH
### =====================================

GET http://localhost:4002/events?search=hackathon


### =====================================
### FILTER BY STATUS
### =====================================

GET http://localhost:4002/events?status=PUBLISHED


### =====================================
### FILTER BY VISIBILITY
### =====================================

GET http://localhost:4002/events?visibility=PUBLIC


### =====================================
### GET EVENT
### =====================================

GET http://localhost:4002/events/EVENT_ID


### =====================================
### CREATE EVENT
### =====================================

POST http://localhost:4002/events
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "title": "Swayam Hackathon 2026",
    "slug": "swayam-hackathon-2026",
    "description": "Annual technical hackathon conducted by Swayam.",
    "shortDescription": "Technical hackathon",
    "venue": "Vasavi College of Engineering",
    "startTime": "2026-11-10T09:00:00+05:30",
    "endTime": "2026-11-11T09:00:00+05:30",
    "capacity": 500,
    "registrationDeadline": "2026-11-09T23:59:59+05:30",
    "visibility": "PUBLIC",
    "bannerUrl": "https://example.com/banner.png"
}


### =====================================
### UPDATE EVENT
### =====================================

PATCH http://localhost:4002/events/EVENT_ID
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "title": "Swayam Hackathon 2026 Updated",
    "capacity": 600
}


### =====================================
### PUBLISH EVENT
### =====================================

PATCH http://localhost:4002/events/EVENT_ID/status
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "status": "PUBLISHED"
}


### =====================================
### START EVENT
### =====================================

PATCH http://localhost:4002/events/EVENT_ID/status
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "status": "ONGOING"
}


### =====================================
### COMPLETE EVENT
### =====================================

PATCH http://localhost:4002/events/EVENT_ID/status
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "status": "COMPLETED"
}


### =====================================
### CANCEL EVENT
### =====================================

PATCH http://localhost:4002/events/EVENT_ID/status
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN
Content-Type: application/json

{
    "status": "CANCELLED"
}


### =====================================
### DELETE EVENT
### =====================================

DELETE http://localhost:4002/events/EVENT_ID
Authorization: Bearer YOUR_FIREBASE_ID_TOKEN