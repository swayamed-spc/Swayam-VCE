# Copy to frontend/.env.local. Everything here ends up in the browser, so it is all public by design.

# API base URL. Leave empty in development (Vite proxies /api to http://localhost:4000).
# In production: the API's URL, e.g. https://api.swayam.example (no trailing slash).
VITE_API_URL=

# Cloudflare Turnstile site key (Cloudflare dashboard > Turnstile). The default below is Cloudflare's test key,
# which always passes and matches the backend's test secret.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Firebase web app config for "Sign in with Google" (Firebase console > Project settings > Your apps).
# Leave empty to hide the Google button. FIREBASE_PROJECT_ID in backend/.env must be the same project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
